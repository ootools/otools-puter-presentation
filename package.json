{
  "name": "otools-puter-presentation",
  "version": "0.1.8",
  "private": true,
  "type": "module",
  "description": "Presentation (HeyPuter/everything) as an OTools plugin: the same editor, with documents stored as plain files on this computer instead of in a Puter cloud account.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "sync-upstream": "node scripts/sync-upstream.mjs",
    "check-upstream": "node scripts/sync-upstream.mjs --check",
    "tree": "node scripts/build.mjs --tree",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "test": "node scripts/test.mjs",
    "preview": "node scripts/serve-dist.mjs",
    "pack": "node scripts/pack-plugin.mjs",
    "verify": "node scripts/verify-plugin.mjs",
    "i18n-report": "node scripts/i18n-report.mjs",
    "release": "node scripts/build.mjs && node scripts/pack-plugin.mjs && node scripts/verify-plugin.mjs"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "lucide": "1.34.0",
    "nspell": "2.1.5",
    "unicode-segmenter": "0.17.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@types/node": "24.13.2",
    "patch-package": "8.0.1",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "jsdom": "30.1.2"
  }
}
